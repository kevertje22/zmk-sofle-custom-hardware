            tap-ms = <10>;
            bindings = <&kp EQUAL &kp EQUAL &kp EQUAL &kp EQUAL &kp EQUAL &kp RET &kp RET &kp C &kp O &kp M &kp B &kp O &kp S &kp COLON &kp SPACE &kp SPACE &kp W &kp E &kp R &kp GT &mac_chshfast_2>;
